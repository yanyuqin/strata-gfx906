@@ -0,0 +1,217 @@
+// src/kernels/i8_pack_bench.cpp - native_expert_i8 on a blob's row-major weights against the same call on strata-pack images
+// (the i8 kernels' packed read layout, i8_expert.cuh): is the output bit-identical, and what does the packed read buy in time.
+//
+//     build/i8_pack_bench [entries] [reps]
+//
+// The case is a UD-Q4_K_XL layer: gate/up Q4_K with down Q5_1 (43 of the model's 48 layers) and Q8_0 (4), n_embd 2560, n_ff 640,
+// 1536 entries over 16 groups (every blob read once), the work of one layer of a 21K prompt.
+#include "strata/kernels/iq_kernels.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <vector>
+
+namespace k = strata::kernels;
+
+namespace {
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "CUDA error in %s: %s\n", what, cudaGetErrorString(e));
+        std::exit(2);
+    }
+}
+
+template <typename T>
+T* dalloc(size_t n) {
+    T* p = nullptr;
+    ck(cudaMalloc(&p, n * sizeof(T)), "alloc");
+    return p;
+}
+
+int block_values(int t) { return t == 20 || t == 6 || t == 8 || t == 7 ? 32 : t == 42 ? 64 : 256; }
+
+// `rows` rows of `n` values of format t, as native_i8_parity's random_rows: random bytes, a finite fp16 scale in every block
+std::vector<uint8_t> random_rows(int t, int64_t rows, int64_t n, std::mt19937& rng) {
+    const size_t rb = k::iq_row_bytes(t, n), bs = k::iq_row_bytes(t, block_values(t));
+    std::vector<uint8_t> w((size_t) rows * rb);
+    std::uniform_int_distribution<int> byte(0, 255), ex(2, 8), man(0, 1023), sgn(0, 1);
+    for (auto& b : w) b = (uint8_t) byte(rng);
+    for (size_t o = 0; o < w.size(); o += bs) {
+        const uint16_t h = (uint16_t) ((sgn(rng) ? 0x8000 : 0) | (ex(rng) << 10) | man(rng));
+        if (t == 14) {
+            std::memcpy(&w[o + 208], &h, 2);
+            continue;
+        }
+        std::memcpy(&w[o], &h, 2);
+        if (t == 12 || t == 13 || t == 7) {
+            const uint16_t h2 = (uint16_t) ((sgn(rng) ? 0x8000 : 0) | (ex(rng) << 10) | man(rng));
+            std::memcpy(&w[o + 2], &h2, 2);
+        }
+    }
+    return w;
+}
+
+struct Case {
+    const char* name;
+    int gu, dt;
+    int64_t n_embd, n_ff;
+    int entries, reps;
+};
+
+int run(const Case& c) {
+    const int H = (int) c.n_embd, FF = (int) c.n_ff;
+    const k::NativeExpertLayout L = k::native_expert_layout(c.gu, c.dt, c.n_embd, c.n_ff);
+    if (!k::native_expert_i8_pk_supported(L)) {
+        std::printf("%-18s : strata-pack does not cover gu %d / down %d\n", c.name, c.gu, c.dt);
+        return 0;
+    }
+    const size_t pk_bytes = k::native_expert_i8_pk_bytes(L);
+    std::printf("%-18s : blob %zu B, packed image %zu B (%+.1f%%), %d entries x %d reps\n", c.name, L.bytes, pk_bytes,
+                100.0 * ((double) pk_bytes / (double) L.bytes - 1.0), c.entries, c.reps);
+
+    std::mt19937 rng(1234);
+    const int n_blobs = 16;   // one layer's experts, as a group walks them
+    const int cap = c.entries;
+    const size_t slot = (L.bytes + 255) & ~(size_t) 255;
+    uint8_t* blobs = dalloc<uint8_t>(slot * (size_t) n_blobs);
+    std::vector<std::vector<uint8_t>> host(n_blobs);
+    for (int i = 0; i < n_blobs; ++i) {
+        host[i].assign(L.bytes, 0);
+        const std::vector<uint8_t> g = random_rows(c.gu, FF, H, rng);
+        const std::vector<uint8_t> u = random_rows(c.gu, FF, H, rng);
+        const std::vector<uint8_t> d = random_rows(c.dt, H, FF, rng);
+        std::memcpy(host[i].data(), g.data(), g.size());
+        std::memcpy(host[i].data() + L.up_off, u.data(), u.size());
+        std::memcpy(host[i].data() + L.down_off, d.data(), d.size());
+        ck(cudaMemcpy(blobs + (size_t) i * slot, host[i].data(), L.bytes, cudaMemcpyHostToDevice), "blob");
+    }
+    cudaStream_t s = nullptr;
+
+    // the entries: groups of 16 experts, each with a whole number of 64-row tiles (the tile kernel's BM)
+    std::vector<unsigned long long> p;
+    std::vector<int32_t> st(1, 0);
+    int e = 0;
+    while (e < cap) {
+        const int m = std::min(96, cap - e);   // 16 groups of 96 = every blob read once
+        p.push_back((unsigned long long) (blobs + slot * (size_t) (p.size() % (size_t) n_blobs)));
+        e += m;
+        st.push_back(e);
+    }
+    const int ng = (int) p.size();
+    std::vector<int32_t> dst(cap), tok(cap);
+    std::iota(dst.begin(), dst.end(), 0);
+    std::shuffle(dst.begin(), dst.end(), rng);
+    for (int i = 0; i < cap; ++i) tok[i] = (int) (rng() % 128);   // 128 tokens' activations
+    unsigned long long* ptr = dalloc<unsigned long long>(ng);
+    int32_t* start = dalloc<int32_t>(ng + 1);
+    int32_t* n = dalloc<int32_t>(1);
+    int32_t* ddst = dalloc<int32_t>(cap);
+    int32_t* dtok = dalloc<int32_t>(cap);
+    ck(cudaMemcpy(ptr, p.data(), p.size() * 8, cudaMemcpyHostToDevice), "ptr");
+    ck(cudaMemcpy(start, st.data(), st.size() * 4, cudaMemcpyHostToDevice), "start");
+    ck(cudaMemcpy(n, &ng, 4, cudaMemcpyHostToDevice), "n");
+    ck(cudaMemcpy(ddst, dst.data(), dst.size() * 4, cudaMemcpyHostToDevice), "dst");
+    ck(cudaMemcpy(dtok, tok.data(), tok.size() * 4, cudaMemcpyHostToDevice), "tok");
+
+    std::vector<float> x((size_t) cap * H);
+    std::normal_distribution<float> nd(0.f, 1.f);
+    for (auto& v : x) v = nd(rng);
+    float* dx = dalloc<float>(x.size());
+    ck(cudaMemcpy(dx, x.data(), x.size() * 4, cudaMemcpyHostToDevice), "x");
+    uint8_t* xq8 = dalloc<uint8_t>((size_t) cap * (size_t) (H / 32) * 36);
+    k::native_expert_i8_quantize(dx, cap, H, xq8, s);
+    const size_t scr_bytes = k::native_expert_scratch_bytes(cap, FF);
+    uint8_t* scr = dalloc<uint8_t>(scr_bytes);
+    const size_t out_floats = (size_t) cap * (size_t) H;
+    float* out = dalloc<float>(out_floats);
+
+    // the packed images of the same blobs
+    uint8_t* pk = dalloc<uint8_t>(pk_bytes * (size_t) n_blobs);
+    k::native_expert_i8_pk_build(L, ptr, n_blobs, pk, s);
+    ck(cudaStreamSynchronize(s), "pack build");
+
+    auto call = [&](bool packed) {
+        ck(cudaMemsetAsync(out, 0xFF, out_floats * 4, s), "memset");
+        ck(cudaMemsetAsync(scr, 0, scr_bytes, s), "memset");
+        if (packed) k::native_expert_i8_pk(L, ptr, start, n, ddst, dtok, cap, cap, xq8, scr, out, s, pk);
+        else k::native_expert_i8(L, ptr, start, n, ddst, dtok, cap, cap, xq8, scr, out, s);
+        ck(cudaStreamSynchronize(s), "sync");
+    };
+    auto grab = [&]() {
+        std::vector<float> o(out_floats);
+        ck(cudaMemcpy(o.data(), out, o.size() * 4, cudaMemcpyDeviceToHost), "out");
+        return o;
+    };
+
+    call(false);
+    const std::vector<float> a = grab();
+    call(true);
+    const std::vector<float> b = grab();
+    int same = 0, diff = 0;
+    float worst = 0.0f;
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (std::memcmp(&a[i], &b[i], 4) == 0) ++same;
+        else {
+            ++diff;
+            const float d = std::fabs(a[i] - b[i]) / std::max(1e-6f, std::fabs(a[i]));
+            worst = std::max(worst, d);
+        }
+    }
+    std::printf("   parity: %d floats bit-identical, %d different (worst relative %.3g)\n", same, diff, worst);
+    if (diff != 0) std::printf("   FAIL: the packed image must give the same bits\n");
+
+    cudaEvent_t t0, t1;
+    ck(cudaEventCreate(&t0), "event");
+    ck(cudaEventCreate(&t1), "event");
+    double ms[2] = {0.0, 0.0};
+    const int rounds = 3;
+    for (int r = 0; r < rounds; ++r) {
+        for (int which = 0; which < 2; ++which) {
+            const bool packed = which == 1;
+            ck(cudaEventRecord(t0, s), "record");
+            for (int i = 0; i < c.reps; ++i) call(packed);
+            ck(cudaEventRecord(t1, s), "record");
+            ck(cudaEventSynchronize(t1), "sync");
+            float e_ms = 0.0f;
+            ck(cudaEventElapsedTime(&e_ms, t0, t1), "elapsed");
+            ms[which] += e_ms / (double) c.reps;   // (the double memset of the call is in this too; it is a fraction of a stage)
+        }
+    }
+    ms[0] /= rounds;
+    ms[1] /= rounds;
+    const double macs = (double) cap * ((double) H * 2.0 * FF + (double) FF * H);   // gate + up + down, per entry
+    // the bytes a call reads once: every expert blob (the packed image is the same weights)
+    const double bytes = (double) n_blobs * (double) L.bytes;
+    std::printf("   blob   : %8.2f ms  %6.1f GMAC/s  %6.1f GB/s\n", ms[0], macs / ms[0] / 1e3, bytes / ms[0] / 1e6);
+    std::printf("   packed : %8.2f ms  %6.1f GMAC/s  %6.1f GB/s  %+.1f%% time\n", ms[1], macs / ms[1] / 1e3, bytes / ms[1] / 1e6,
+                100.0 * (ms[1] / ms[0] - 1.0));
+
+    cudaEventDestroy(t0);
+    cudaEventDestroy(t1);
+    cudaFree(blobs); cudaFree(ptr); cudaFree(start); cudaFree(n); cudaFree(ddst); cudaFree(dtok);
+    cudaFree(dx); cudaFree(xq8); cudaFree(scr); cudaFree(out); cudaFree(pk);
+    return diff == 0 ? 0 : 1;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    Case cases[] = {
+        {"Q4_K / Q5_1 down", 12, 7, 2560, 640, 1536, 30},   // 43 of the model's 48 layers
+        {"Q4_K / Q8_0 down", 12, 8, 2560, 640, 1536, 30},   // 4 layers
+    };
+    if (argc > 1) for (Case& c : cases) c.entries = std::atoi(argv[1]);
+    if (argc > 2) for (Case& c : cases) c.reps = std::atoi(argv[2]);
+    int rc = 0;
+    for (const Case& c : cases) rc |= run(c);
+    std::printf(rc == 0 ? "OK\n" : "FAILED\n");
+    return rc;
+}
